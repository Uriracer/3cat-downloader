# Copia aquest fitxer a .env i adapta'l.

# Usuari i grup propietaris dels fitxers (ordre «id» a l'amfitrió).
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Configuració de cada aplicació (disc ràpid, fes-ne còpia de seguretat).
CONFIG_ROOT=/opt/media/config

# Carpeta única de dades: torrents, descàrregues de 3cat i biblioteques.
DATA_ROOT=/srv/data

# Propietari del repositori a GitHub (la imatge és ghcr.io/uriracer/3cat-downloader).
GHCR_OWNER=uriracer

# Contrasenya de 3Cat Downloader. Si la deixes buida, la crearàs des del navegador.
TRESDL_PASSWORD=
